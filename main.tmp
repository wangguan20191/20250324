terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.40.0"
    }
  }
}

provider "aws" {
  region = var.region
  # access_key = "AKIAWH45H5J4HV6KPKFJ"
  # secret_key = "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"
}

# 创建 VPC
resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = {
    Name = "prod-vpc"
  }
}

# 私有子网（无自动公网 IP）
resource "aws_subnet" "private_subnet" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.private_subnet_cidr   # 例如 10.0.2.0/24
  availability_zone       = "ap-southeast-1a"
  map_public_ip_on_launch = false
  tags = {
    Name        = "private-subnet"
    NetworkType = "private"
    Purpose     = "backend-services"
  }
}

# 公有子网（自动分配公网 IP）
resource "aws_subnet" "public_subnet" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.public_subnet_cidr    # 例如 10.0.1.0/24（必须是私有 IP 段）
  availability_zone       = "ap-southeast-1a"
  map_public_ip_on_launch = true
  tags = {
    Name        = "public-subnet"
    NetworkType = "public"
  }
}

# 互联网网关
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "prod-igw"
  }
}

# 路由表：包含指向 IGW 的默认路由
resource "aws_route_table" "public_rt" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }

  tags = {
    Name = "public-route-table"
  }
}

# 将路由表关联到公有子网
resource "aws_route_table_association" "public_assoc" {
  subnet_id      = aws_subnet.public_subnet.id
  route_table_id = aws_route_table.public_rt.id
}



# 1. 安全组：允许 HTTP、HTTPS 和 SSH 访问
resource "aws_security_group" "nginx_sg" {
  name        = "nginx-sg"
  description = "Allow HTTP, HTTPS and SSH from internet"
  vpc_id      = aws_vpc.main.id

  # HTTP 访问
  ingress {
    description = "HTTP from anywhere"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # HTTPS 访问
  ingress {
    description = "HTTPS from anywhere"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # SSH 访问（可选，便于调试）
  ingress {
    description = "SSH from anywhere"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # 所有出站流量允许
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "nginx-sg"
  }
}

# 2. SSH 密钥对（用于登录 EC2）
resource "tls_private_key" "nginx_key" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "nginx_key_pair" {
  key_name   = "nginx-key-pair"
  public_key = tls_private_key.nginx_key.public_key_openssh
}

# 将私钥保存到本地文件（方便 SSH 登录）
resource "local_file" "nginx_private_key" {
  content         = tls_private_key.nginx_key.private_key_pem
  filename        = "${path.module}/nginx-key-pair.pem"
  file_permission = "0400"
}

# 3. EC2 实例运行 Nginx
resource "aws_instance" "nginx_server" {
  ami                    = data.aws_ami.amazon_linux_2.id   # 动态获取最新的 Amazon Linux 2 AMI
  instance_type          = "t2.micro"
  key_name               = aws_key_pair.nginx_key_pair.key_name
  vpc_security_group_ids = [aws_security_group.nginx_sg.id]
  subnet_id              = aws_subnet.public_subnet.id       # 放置在公有子网中

  # 用户数据脚本：安装 Nginx 并启动
  user_data = <<-EOF
    #!/bin/bash
    yum update -y
    amazon-linux-extras install nginx1 -y
    systemctl start nginx
    systemctl enable nginx
    echo "<h1>Hello from Terraform Nginx on $(hostname -f)</h1>" > /usr/share/nginx/html/index.html
  EOF

  tags = {
    Name = "nginx-server"
  }
}

# 安装 OpenResty
resource "null_resource" "install_openresty" {
  depends_on = [aws_instance.nginx_server]

  connection {
    type        = "ssh"
    user        = "ec2-user"
    private_key = tls_private_key.nginx_key.private_key_pem
    host        = aws_instance.nginx_server.public_ip
  }

  provisioner "remote-exec" {
    inline = [
      "yum update -y",
      "yum install -y yum-utils",
      "yum-config-manager --add-repo https://openresty.org/package/amazon/openresty.repo",
      "yum install -y openresty",
      "systemctl stop nginx",
      "systemctl disable nginx",
      "systemctl start openresty",
      "systemctl enable openresty",
      "echo '<h1>Hello from Terraform OpenResty on $(hostname -f)</h1>' > /usr/local/openresty/nginx/html/index.html"
    ]
  }
}

# 4. 获取最新的 Amazon Linux 2 AMI（新加坡区域）
data "aws_ami" "amazon_linux_2" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*-x86_64-gp2"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# 5. 输出 Nginx 服务器的公网 IP
output "nginx_public_ip" {
  value       = aws_instance.nginx_server.public_ip
  description = "Public IP address of the Nginx server"
}

output "nginx_public_dns" {
  value       = aws_instance.nginx_server.public_dns
  description = "Public DNS of the Nginx server"
}


